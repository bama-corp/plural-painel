# Base de dados PostgreSQL
# Neon: mesma URL em DATABASE_URL e DIRECT_URL – ver docs/CONFIG-NEON.md
# Supabase: ver docs/CONFIG-SUPABASE.md (duas URLs diferentes)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth — string longa e aleatória (nunca commits com valores reais)
JWT_SECRET="gerar_com_openssl_rand_hex_32"

# Cifra em repouso (AES-256-GCM) — senhas/PINs Netflix/IPTV/sala e cópias admin
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""

# Origens CORS em produção (vírgulas). Ex.: https://teu-dominio.vercel.app,http://localhost:5173
# Inclui a origem do painel PH se o browser chamar a API directamente.
# Em produção sem CORS_ORIGINS (e sem VERCEL_URL), pedidos browser são rejeitados.
CORS_ORIGINS=""

# Primeiro admin (usado pelo seed)
ADMIN_EMAIL="admin@plural.com"
ADMIN_PASSWORD="admin123"

# WhatsApp Business
# API whatsapp-web.js no Railway — ver docs/RAILWAY-WHATSAPP.md
WHATSAPP_PHONE="244933623143"
WHATSAPP_API_URL="https://SEU-SERVICO.up.railway.app"
WHATSAPP_TOKEN="mesmo_token_definido_na_api_whatsapp"

# Cron alertas (Vercel Cron → /api/cron/alertas diariamente)
CRON_SECRET=""

# Painel PH — leitura de clientes/MRR (GET /api/ph/summary). Bearer token.
# Em CORS_ORIGINS inclui a origem do PH em produção (ex.: https://ph.teu-dominio.com).
# Em desenvolvimento o CORS já aceita localhost.
PH_API_KEY=""

# Frontend (URL da API em produção; deixar vazio se mesmo domínio)
# VITE_API_URL="https://seu-dominio.vercel.app"
